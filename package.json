{
  "name": "graphql-markdown-demo",
  "description": "GraphQL-Markdown demonstration",
  "keywords": [],
  "homepage": "https://graphql-markdown.github.io",
  "version": "1.34.0",
  "private": true,
  "bugs": {
    "url": "https://github.com/graphql-markdown/graphql-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/graphql-markdown/graphql-markdown-demo.git"
  },
  "author": {
    "name": "Gregory Heitz"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build && node -e \"require('node:fs').cpSync('.markdown-copies','build',{recursive:true})\"",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "dev": "docusaurus start",
    "doc": "docusaurus graphql-to-doc && docusaurus graphql-to-doc:markdown",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-content-blog": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/plugin-content-pages": "^3.10.2",
    "@docusaurus/plugin-css-cascade-layers": "^3.10.2",
    "@docusaurus/plugin-debug": "^3.10.2",
    "@docusaurus/plugin-google-analytics": "^3.10.2",
    "@docusaurus/plugin-google-gtag": "^3.10.2",
    "@docusaurus/plugin-google-tag-manager": "^3.10.2",
    "@docusaurus/plugin-sitemap": "^3.10.2",
    "@docusaurus/plugin-svgr": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@docusaurus/theme-search-algolia": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@graphql-markdown/docusaurus": "^1.39.4",
    "@graphql-markdown/formatters": "^1.3.0",
    "@graphql-markdown/graphql": "^1.4.0",
    "@graphql-markdown/printer-legacy": "^1.21.0",
    "@graphql-tools/url-loader": "^10.0.9",
    "@mdx-js/react": "^3.1.1",
    "graphql": "^17.1.0",
    "graphql-config": "^6.0.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.10.2",
